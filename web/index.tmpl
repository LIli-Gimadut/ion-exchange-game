    <link rel="icon" type="image/png" href="favicon.png" sizes="16x16">

    <style>
        :root {
            color-scheme: dark;
            font-family: Montserrat, Inter, ui-rounded, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif;
            --ink: #fff;
            --muted: #d7c4ea;
            --lavender: #bc96e6;
            --gold: #ffd166;
            --plum: #210b2c;
        }

        * { box-sizing: border-box; }

        html, body {
            width: 100%;
            min-height: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            overscroll-behavior: none;
            background:
                radial-gradient(circle at 15% 10%, rgba(188, 150, 230, .25), transparent 34%),
                radial-gradient(circle at 88% 85%, rgba(255, 209, 102, .16), transparent 34%),
                linear-gradient(145deg, #210b2c 0%, #241842 48%, #111226 100%);
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: .35;
            background-image: radial-gradient(rgba(255,255,255,.24) .7px, transparent .7px);
            background-size: 22px 22px;
        }

        #transfer {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: grid;
            place-items: center;
            padding: max(24px, env(safe-area-inset-top))
                max(24px, env(safe-area-inset-right))
                max(24px, env(safe-area-inset-bottom))
                max(24px, env(safe-area-inset-left));
            background: rgba(20, 12, 37, .78);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            transition: opacity .45s ease, visibility .45s ease;
        }

        #transfer.is-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .loader-card {
            position: relative;
            width: min(100%, 430px);
            padding: clamp(28px, 6vw, 46px);
            overflow: hidden;
            text-align: center;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 28px;
            background: linear-gradient(145deg, rgba(255,255,255,.12), rgba(255,255,255,.05));
            box-shadow: 0 28px 80px rgba(8, 4, 20, .45), inset 0 1px rgba(255,255,255,.14);
        }

        .loader-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -90px;
            top: -100px;
            border-radius: 50%;
            background: rgba(255, 209, 102, .17);
            filter: blur(8px);
        }

        .atom {
            position: relative;
            width: 82px;
            height: 82px;
            margin: 0 auto 24px;
        }

        .atom::before {
            content: "";
            position: absolute;
            inset: 32px;
            z-index: 2;
            border-radius: 50%;
            background: var(--gold);
            box-shadow: 0 0 26px rgba(255, 209, 102, .7);
        }

        .orbit {
            position: absolute;
            inset: 17px 2px;
            border: 2px solid rgba(218, 190, 244, .8);
            border-radius: 50%;
            animation: orbit 2.8s linear infinite;
        }

        .orbit:nth-child(2) { transform: rotate(60deg); animation-delay: -.9s; }
        .orbit:nth-child(3) { transform: rotate(-60deg); animation-delay: -1.8s; }

        .orbit::after {
            content: "";
            position: absolute;
            width: 9px;
            height: 9px;
            top: -4px;
            left: 50%;
            border-radius: 50%;
            background: var(--lavender);
            box-shadow: 0 0 12px rgba(188, 150, 230, .8);
        }

        @keyframes orbit { to { rotate: 360deg; } }

        .loader-kicker {
            margin: 0 0 8px;
            color: var(--gold);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .loader-title {
            margin: 0;
            color: var(--ink);
            font-size: clamp(25px, 7vw, 34px);
            line-height: 1.08;
            letter-spacing: -.035em;
        }

        #status {
            margin: 16px 0 18px;
            min-height: 1.4em;
            color: var(--muted);
            font-size: 14px;
            font-weight: 600;
        }

        #progress {
            display: block;
            width: 100%;
            height: 8px;
            overflow: hidden;
            border: 0;
            border-radius: 999px;
            appearance: none;
            -webkit-appearance: none;
            background: rgba(255,255,255,.1);
        }

        #progress::-webkit-progress-bar { background: rgba(255,255,255,.1); }
        #progress::-webkit-progress-value {
            border-radius: 999px;
            background: linear-gradient(90deg, var(--lavender), var(--gold));
            box-shadow: 0 0 18px rgba(188, 150, 230, .45);
            transition: width .2s ease;
        }
        #progress::-moz-progress-bar {
            border-radius: 999px;
            background: linear-gradient(90deg, var(--lavender), var(--gold));
        }

        .loader-note {
            margin: 16px 0 0;
            color: rgba(255,255,255,.52);
            font-size: 12px;
        }

        #infobox { display: none; }
        div.emscripten { text-align: center; }
        div.emscripten_border { border: 0; }

        /* Pygbag keeps the logical 920×740 surface and scales it without
           changing the pointer coordinate system. */
        canvas.emscripten {
            position: fixed;
            inset: 0;
            z-index: 5;
            display: block;
            max-width: 100vw;
            max-height: 100dvh;
            padding: 0;
            margin: auto;
            border: 0;
            outline: none;
            background: transparent;
            touch-action: none;
            filter: drop-shadow(0 24px 54px rgba(4, 2, 14, .34));
            opacity: 0;
            transition: opacity .4s ease;
        }

        canvas.emscripten.is-ready { opacity: 1; }

        #fullscreen-button {
            position: fixed;
            z-index: 20;
            right: max(14px, env(safe-area-inset-right));
            bottom: max(14px, env(safe-area-inset-bottom));
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 999px;
            color: var(--ink);
            font: 700 13px/1 inherit;
            background: rgba(33, 11, 44, .72);
            box-shadow: 0 10px 30px rgba(0,0,0,.22);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
            transition: opacity .25s ease, transform .25s ease, background .2s ease;
        }

        #fullscreen-button.is-visible {
            opacity: 1;
            pointer-events: auto;
            transform: none;
        }

        #fullscreen-button:hover { background: rgba(79, 53, 107, .9); }
        #fullscreen-button svg { width: 16px; height: 16px; }

        #orientation-hint {
            position: fixed;
            z-index: 19;
            top: max(12px, env(safe-area-inset-top));
            left: 50%;
            display: none;
            width: max-content;
            max-width: calc(100vw - 24px);
            padding: 9px 13px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 999px;
            color: var(--ink);
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            background: rgba(33, 11, 44, .8);
            backdrop-filter: blur(10px);
            transform: translateX(-50%);
        }

        .topright { position: absolute; top: 0; right: 0; }
        .bottomright { position: absolute; top: 40%; right: 0; }
        .trinfo { position: relative; right: 0; border: 0; }
        .framed { position: relative; top: 150px; right: 10px; border: 0; }

        @media (max-width: 720px) and (orientation: portrait) {
            #orientation-hint { display: block; }
            #fullscreen-button span { display: none; }
            #fullscreen-button { padding: 11px; }
        }

        @media (max-height: 520px) {
            .loader-card { padding: 22px 30px; }
            .atom { width: 62px; height: 62px; margin-bottom: 14px; }
            .atom::before { inset: 24px; }
            .orbit { inset: 13px 1px; }
            .loader-note { display: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>

